# Copy to .env and adjust. All keys are prefixed with ML_.
ML_APP_NAME="Regreen ML Service"
ML_ENVIRONMENT=local
ML_DEBUG=true

# Shared secret. The Laravel app must send this as the X-API-Key header.
# Leave empty ONLY in local dev; always set a strong value in production.
ML_API_KEY=

# Front-end origins allowed to call this service directly (comma-separated).
ML_ALLOWED_ORIGINS=http://localhost:5173

# Directory that holds model artifacts.
ML_MODEL_DIR=models

# --- Terrain context (DEM sampling) ---
# Which Digital Elevation Model to sample for a survey point:
#   auto   - DEMNAS inside Indonesia, NASA SRTM (Earth Engine) elsewhere
#   demnas - BIG DEMNAS only
#   srtm   - NASA SRTM via Google Earth Engine only
#   none   - skip terrain context entirely
ML_TERRAIN_SOURCE=auto

# Allow a lower-resolution DEM to stand in when the preferred one cannot answer.
ML_TERRAIN_FALLBACK=true

# HTTP timeout (seconds) for DEM service calls.
ML_TERRAIN_TIMEOUT=20

# BIG (Badan Informasi Geospasial) national DEM image service.
ML_DEMNAS_SERVICE_URL=https://geoservices.big.go.id/raster/rest/services/DEMNAS/DEM_Indonesia/ImageServer

# Google Earth Engine, for the NASA SRTM fallback. Needs a Google Cloud project
# plus a service account that has been granted Earth Engine access, otherwise
# the SRTM source reports itself as unconfigured.
ML_GEE_PROJECT=
ML_GEE_SERVICE_ACCOUNT=
ML_GEE_PRIVATE_KEY_FILE=
ML_GEE_SRTM_ASSET=USGS/SRTMGL1_003
ML_GEE_TIMEOUT=60

# --- Soil context (ISRIC SoilGrids, 250 m, global, no key) ---
#   soilgrids - query ISRIC's public point API (clay/silt/sand, SOC, pH, nitrogen)
#   none      - skip soil context
ML_SOIL_SOURCE=soilgrids
ML_SOIL_TIMEOUT=30
ML_SOIL_GRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# --- Climate context (NASA POWER agroclimatology, no key) ---
#   power - query NASA POWER climatology (rainfall, temperature, humidity, topsoil wetness)
#   none  - skip climate context
ML_CLIMATE_SOURCE=power
ML_CLIMATE_TIMEOUT=30
ML_POWER_URL=https://power.larc.nasa.gov/api/temporal/climatology/point

# Soil and climate normals change on a yearly scale, so samples are cached per
# coordinate instead of re-querying the public APIs for every analysis.
ML_POINT_CACHE_SIZE=256

# --- Burn detector (YOLOv8) ---
# Weights for the fine-tuned six-class burn detector, resolved from the ml/
# directory. Without this file (or without `ultralytics`) land analysis falls
# back to the colour heuristic and reports the reason in fire_severity.reason.
ML_YOLO_WEIGHTS=models/regreen-burn-yolov8n.pt
ML_YOLO_CONFIDENCE=0.25
ML_YOLO_IOU=0.45
ML_YOLO_IMGSZ=640
# Leave empty to let ultralytics choose (GPU when available, else CPU).
ML_YOLO_DEVICE=
ML_YOLO_MODEL_VERSION=0.2.0
